{
	"name": "trustknots",
	"version": "0.0.0",
	"description": "",
	"main": "index.js",
	"private": true,
	"type": "module",
	"scripts": {
		"preinstall": "npx -y only-allow pnpm",
		"test": "pnpm --filter @trustknots/* test",
		"format": "pnpm --filter @trustknots/* format",
		"build": "pnpm --filter @trustknots/* build",
		"doc": "pnpm --filter docusaurus",
		"typecheck": "pnpm -r --filter @trustknots/* typecheck",
		"pack:vcknots": "cd issuer+verifier && npm pack",
		"publish:vcknots": "cd issuer+verifier && npm publish --access public",
		"prepare": "husky",
		"test:conformance": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx tests/conformance/src/runner.ts",
		"ping:conformance": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx tests/conformance/src/sample.ts",
		"test:haip": "tsx tests/conformance/runner/index.ts --profile=haip-1.0",
		"test:haip:v5.1.43": "tsx tests/conformance/runner/index.ts --profile=haip-1.0 --suite=v5.1.43",
		"test:haip:v5.2.0": "tsx tests/conformance/runner/index.ts --profile=haip-1.0 --suite=v5.2.0",
		"compose:up": "docker compose -f tests/conformance/suites/docker-compose-prebuilt.yml up -d",
		"compose:down": "docker compose -f tests/conformance/suites/docker-compose-prebuilt.yml down -v"
	},
	"keywords": [],
	"author": "trustknots",
	"license": "Apache-2.0",
	"files": [
		"issuer+verifier/"
	],
	"engines": {
		"pnpm": "11.10.0",
		"npm": "please_use_pnpm_instead"
	},
	"packageManager": "pnpm@11.10.0",
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@changesets/cli": "2.31.1",
		"@types/node": "24.13.3",
		"husky": "9.1.7",
		"tsx": "4.23.5",
		"typescript": "6.0.3"
	}
}
