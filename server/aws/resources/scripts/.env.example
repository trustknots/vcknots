# Copy to .env and adjust for local deploy defaults.
# AWS_PROFILE=vc-knots
API_STAGE=test
# Comma-separated HTTPS origins for API Gateway CORS (required when API_STAGE=prod).
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://wallet.example.com
# Secret pepper for tx_code HMAC hashing, wired into the Issuer/Authz Lambda environment (required to deploy).
# TX_CODE_PEPPER=<your-tx-code-pepper-here>
